# Copy to .env for local runs (`npm run dev` reads it), or to .dev.vars for
# `wrangler dev`. In production set these as secrets on your host instead:
#   npx wrangler secret put RPC_URL
# Never commit the real file.

# --- Required in practice ---------------------------------------------------

# Any JSON-RPC endpoint for your chain. The built-in public defaults work, but
# they are shared and rate limited, so use your own for a live mint.
# Alchemy, for example:
RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Only with the shuffle turned on ---------------------------------------

# The secret that decides which artwork each token ID gets. Generate it with
# `npm run seed:new`. Losing it means you can never reveal, so keep a copy
# somewhere safe, and publish the commitment (not this) before your mint.
# SHUFFLE_SEED=

# Set to true once minting is done, to publish the seed at /provenance so
# holders can verify the mapping for themselves.
# PUBLISH_SEED=false

# --- Only with a webhook ---------------------------------------------------

# From the Alchemy dashboard, Webhooks, then the signing key for your webhook.
# Setting this enables POST /webhook/alchemy. Without it the route is 404.
# ALCHEMY_WEBHOOK_SIGNING_KEY=

# Your own shared secret for POST /webhook/mint, if you would rather push mints
# from a different provider or your own script. Sent as a bearer token.
# WEBHOOK_SECRET=

# --- Only with metadata.source "http" --------------------------------------

# METADATA_HTTP_BASE_URL=https://my-private-bucket.example.com/drop
# METADATA_HTTP_AUTHORIZATION=Bearer some-token

# --- Escape hatches --------------------------------------------------------

# Reveal every token at once, whatever the chain says. Useful after your drop
# mints out, and as a way to undo a mistake without redeploying.
# REVEAL_ALL=false

# Port for `npm run dev`.
# PORT=8787
